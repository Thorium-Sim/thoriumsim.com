{
  "name": "thoriumsim-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server.ts",
    "test": "NODE_ENV=test bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "atproto-add": "lex install --manifest app/lexicons.json  --lexicons app/atproto",
    "postatproto-add": "npm run atproto-build",
    "atproto-build": "lex build --lexicons app/atproto --override --import-ext '.ts' --out app/atproto",
    "migrate": "remix db",
    "postinstall": "bunx patch-package",
    "knip": "knip"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@atproto/lex": "^0.3.4",
    "@atproto/xrpc": "^0.8.10",
    "@epic-web/cachified": "^5.6.3",
    "@thorium-sim/plainjob": "^0.0.26",
    "@types/unist": "^3.0.3",
    "aws4fetch": "^1.0.20",
    "cachified-adapter-sqlite": "^1.1.0",
    "jose": "^6.2.9",
    "limiter": "^3.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remix": "^3.0.0-beta.10",
    "rss": "^1.2.2",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@pitlane/dev": "^0.5.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/rss": "^0.0.32",
    "knip": "^6.32.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
